# Copia este archivo como .env y rellena los valores reales.
# En producción, estas variables se configuran en Vercel (Project Settings > Environment Variables).

# --- Google Apps Script (recargas generales) ---
# Usada en: api/_lib/juegos/freefire.js (precios y recarga), api/_lib/descuentos.js (pestaña
# "Descuentos", común a todas las tiendas, también FC Mobile, COD Mobile y Clash Royale), api/creadores.js (panel de creadores), api/subir-imagen.js
# y api/centralone-webhook.js (estado de los pedidos de Free Fire en Central One)
SCRIPT_RECARGAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Token compartido con TODOS los Apps Script (recargas, bloodstrike, mobilelegends, roblox, ruleta,
# validador y manuales). llamarScript lo envía en el cuerpo de cada llamada. OBLIGATORIO desde 2026-11-08: cada
# script necesita la propiedad TOKEN_VERCEL con este mismo valor; si falta o no coincide, responde
# "No autorizado" y la tienda no funciona. Configurar PRIMERO aquí y DESPUÉS las propiedades.
# api/_lib/fidelidad.js deriva de él la llave que firma el premio de cliente fiel (si cambia, las firmas
# ya entregadas dejan de valer; no pasa nada: Supabase sigue mandando).
SCRIPT_RECARGAS_TOKEN=

# Usada en: api/consultar-ordenes.js
SCRIPT_RECARGAS_VERIFICACION=https://script.google.com/macros/s/XXXXXXXX/exec

# Usada en: api/_lib/juegos/freefire.js, bloodstrike.js y mobilelegends.js (acción verificar de api/juego.js).
# Código: apps-script/validador.gs (sus llaves van en las Propiedades del script, no aquí).
SCRIPT_VALIDADOR_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Usada en: api/ruleta.js (Ruleta de la Suerte). URL /exec del Apps Script de la ruleta,
# publicado como aplicación web con acceso "Cualquier usuario". Código: apps-script/ruleta.gs.
# Si falta o no responde en 20 s (con un reintento), /api/ruleta responde 503 con un aviso y la recarga
# no se ve afectada. Envía también SCRIPT_RECARGAS_TOKEN: el script lo exige solo si tiene TOKEN_VERCEL.
SCRIPT_RULETA_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- Roblox ---
# Usada en: api/_lib/juegos/roblox.js (precios y compra). Código: apps-script/roblox.gs.
# También recibe SCRIPT_RECARGAS_TOKEN: el script lo exige solo si tiene la propiedad TOKEN_VERCEL.
# api/centralone-webhook.js también la usa (avisos de los pedidos de Roblox en Central One).
GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# roblox_nuevo: llave de Central One para comprar códigos de Roblox cuando no quedan guardados en la
# pestaña "Codigos", con los permisos catalog:read, orders:read, orders:write y codes:read (sin
# codes:read compra el código pero no puede leerlo: llegaría solo por el webhook). Usada en:
# api/_lib/juegos/roblox.js y api/centralone-webhook.js. Sin ella, Roblox vende solo los códigos
# guardados (como antes). AUTORIZA A GASTAR TODO EL SALDO Y REVELA CÓDIGOS: solo aquí (Vercel).
roblox_nuevo=

# --- Free Fire (Central One) ---
# freefire_nuevo: llave de Central One para el modo API de Free Fire (menú "🖐️ Recargas Free Fire →
# 🛒 API de Central One" de recargas.gs), con los permisos catalog:read, orders:read y orders:write
# (codes:read NO: es recarga directa al ID). El product_id de cada paquete está en la fila 3 de "precios".
# Usada en: api/_lib/juegos/freefire.js. Sin ella, en modo API los pedidos van a "sin_codigo" (a mano).
# AUTORIZA A GASTAR TODO EL SALDO: solo aquí (Vercel). Puede ser la misma llave que blood_nuevo.
freefire_nuevo=

# --- Blood Strike (Central One) ---
# SCRIPT_BLOOD: api/_lib/juegos/bloodstrike.js (precios y recarga) y api/centralone-webhook.js.
SCRIPT_BLOOD=https://script.google.com/macros/s/XXXXXXXX/exec

# blood_nuevo: llave de la API de Central One (portal > Integración > Llaves de API), con los
# permisos catalog:read, balance:read, orders:read y orders:write (codes:read NO: Blood Strike es
# recarga directa, sin códigos). Usada en: api/_lib/juegos/bloodstrike.js. Sin ella, la tienda de
# Blood Strike responde "no disponible" antes de tocar el pago. AUTORIZA A GASTAR TODO EL SALDO:
# solo aquí (Vercel), nunca en public/ ni en el código.
blood_nuevo=

# --- Mobile Legends (Central One) ---
# SCRIPT_MLBB: URL /exec del Apps Script de la hoja de Mobile Legends (apps-script/mobilelegends.gs).
# Usada en: api/_lib/juegos/mobilelegends.js (precios y recarga) y api/centralone-webhook.js (avisos con
# idempotency_key "ml-…"). También recibe SCRIPT_RECARGAS_TOKEN (el script lo exige si tiene TOKEN_VERCEL).
SCRIPT_MLBB=https://script.google.com/macros/s/XXXXXXXX/exec

# Mobile Legends usa la MISMA llave de Central One que Blood Strike (blood_nuevo, más abajo): no hace falta
# otra variable. Opcional: mlbb_nuevo, solo si algún día se quiere una llave aparte (catalog:read,
# orders:read y orders:write). Usada en: api/_lib/juegos/mobilelegends.js. Sin llave (o sin SCRIPT_MLBB)
# la tienda responde "no disponible" antes de tocar el pago. AUTORIZA A GASTAR TODO EL SALDO: solo en Vercel.
# mlbb_nuevo=

# --- Recargas manuales (FC Mobile, COD Mobile, Clash Royale) ---
# SCRIPT_MANUALES: URL /exec del Apps Script de la hoja de recargas manuales (apps-script/manuales.gs).
# Usada en: api/_lib/juegos/manuales.js (precios y pedidos de los tres juegos). Recibe también
# SCRIPT_RECARGAS_TOKEN: el script EXIGE la propiedad TOKEN_VERCEL con ese mismo valor. Sin esta variable
# las tres tiendas responden "no disponible" sin tocar ningún pago.
SCRIPT_MANUALES=https://script.google.com/macros/s/XXXXXXXX/exec

# Secreto del webhook de Central One (portal > Integración > Webhooks, URL
# https://levelupstore.online/api/centralone-webhook, eventos order.delivered, order.failed,
# order.partially_delivered y order.refunded). Usada en: api/centralone-webhook.js, que comprueba la
# firma X-CentralOne-Signature y pasa el estado de cada pedido a "fazer_card" de la hoja de Blood Strike
# o de Free Fire (idempotency_key "ff-…"), a "pedidos" de la hoja de Mobile Legends ("ml-…") o, si es de Roblox, entrega el código o libera el pago en la
# hoja de Roblox ("pedidos_api").
CENTRALONE_WEBHOOK_SECRET=

# FazerCards ya no se usa para comprar (desde 2026-10-21 Free Fire compra en Central One): FAZER_API_KEY
# se puede borrar de Vercel. El secreto del webhook queda mientras haya órdenes anteriores por cerrar.
# Secreto del webhook de FazerCards (panel de FazerCards > Settings > Webhook, URL
# https://levelupstore.online/api/fazer-webhook). Usada en: api/fazer-webhook.js, que comprueba la firma
# X-Webhook-Signature y pasa el estado de cada orden a la pestaña "fazer_card" de la hoja de Free Fire.
FAZER_WEBHOOK_SECRET=

# --- Bot de canje (Railway) ---
# Usada en: api/_lib/juegos/freefire.js (recarga). Se envía en la cabecera x-secret-token al bot (POST /canjear).
# Debe ser EXACTAMENTE igual a la variable WEBHOOK_SECRET del servicio del bot en Railway;
# si no coincide, el bot responde 401 "No autorizado".
RAILWAY_SECRET=

# --- Límite de intentos fallidos de recarga (anti fuerza bruta de referencias) ---
# Usada en: api/_lib/limitador.js (desde las recargas de api/_lib/juegos/)
# JSON completo de una cuenta de servicio de Firebase, en UNA sola línea.
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# Sin esta variable el límite funciona solo en memoria (protección débil en Vercel).
FIREBASE_SERVICE_ACCOUNT=

# --- Supabase (perfil del cliente, historial en vivo y premio de cliente fiel) ---
# Proyecto de Supabase con las tablas de supabase/levelup.sql (SQL Editor → pegar y Run) e inicio de
# sesión con Google (Authentication → Sign In / Providers → Google). Desde 2026-11-13.
# Usadas en: api/_lib/supabase.js (historial.js, fidelidad.js: premio de cliente fiel y "Más vendido")
# y api/version.js (?config=1, lo público para public/js/sesion.js).
# Sin SUPABASE_URL + SUPABASE_SECRET_KEY: no hay perfil, ni premio de cliente fiel, ni "Más vendido";
# las compras siguen igual. Sin SUPABASE_PUBLISHABLE_KEY: el botón "Entrar" dice que no está disponible.
# Supabase → Project Settings → API Keys.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Llave PUBLICABLE (sb_publishable_…, o la "anon" vieja): la recibe el navegador, es pública.
SUPABASE_PUBLISHABLE_KEY=
# Llave SECRETA (sb_secret_…, o la "service_role" vieja): salta todas las reglas. SOLO aquí (Vercel),
# nunca en public/ ni en el código.
SUPABASE_SECRET_KEY=

# --- Gemini API (soporte IA) ---
# Usadas en: api/ia-soporte.js
# GEMINI_KEYS tiene prioridad: lista separada por comas para rotar claves.
# Si no está definida, se usa GEMINI_API_KEY como clave única.
GEMINI_KEYS=clave1,clave2
GEMINI_API_KEY=

# Modelo de Gemini para el chat (opcional). Por defecto: gemini-2.5-flash.
# Los modelos gemini-1.5-* fueron retirados por Google y responden 404.
GEMINI_MODEL=

# Opcional: oculta el aviso DEP0169 (url.parse) que aparece en los logs de Vercel. No viene de
# nuestro código (api/ no usa url.parse) sino del entorno de ejecución o de una librería; es inofensivo.
# NODE_OPTIONS=--disable-warning=DEP0169
