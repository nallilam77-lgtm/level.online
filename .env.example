# Copia este archivo como .env y rellena los valores reales.
# En producción, estas variables se configuran en Vercel (Project Settings > Environment Variables).

# --- Google Apps Script (recargas generales) ---
# Usada en: api/_lib/juegos/freefire.js (precios y recarga), api/_lib/descuentos.js (pestaña
# "Descuentos", común a Free Fire, Blood Strike y Roblox), api/creadores.js (panel de creadores) y api/subir-imagen.js
SCRIPT_RECARGAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Token compartido con el Apps Script de recargas (apps-script/recargas.gs). Se envía en el cuerpo
# de cada llamada; el script rechaza las peticiones sin él cuando su propiedad TOKEN_VERCEL existe.
# Configurar PRIMERO aquí (y redesplegar) y DESPUÉS la propiedad TOKEN_VERCEL en Apps Script.
SCRIPT_RECARGAS_TOKEN=

# Usada en: api/consultar-ordenes.js
SCRIPT_RECARGAS_VERIFICACION=https://script.google.com/macros/s/XXXXXXXX/exec

# Usada en: api/_lib/juegos/freefire.js (acción verificar de api/juego.js)
SCRIPT_VALIDADOR_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Usada en: api/ruleta.js (Ruleta de la Suerte). URL /exec del Apps Script de la ruleta,
# publicado como aplicación web con acceso "Cualquier usuario". Código: apps-script/ruleta.gs.
# Si falta o no responde en 20 s (con un reintento), /api/ruleta responde 503 con un aviso y la recarga
# no se ve afectada. Envía también SCRIPT_RECARGAS_TOKEN: el script lo exige solo si tiene TOKEN_VERCEL.
SCRIPT_RULETA_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- Roblox ---
# Usada en: api/_lib/juegos/roblox.js (precios y compra). Código: apps-script/roblox.gs.
# También recibe SCRIPT_RECARGAS_TOKEN: el script lo exige solo si tiene la propiedad TOKEN_VERCEL.
GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- Blood Strike y FazerCards ---
# SCRIPT_BLOOD: api/_lib/juegos/bloodstrike.js (precios y recarga).
# FAZER_API_KEY: recargas por la API de FazerCards de Blood Strike y de Free Fire (modo API del menú
# "🖐️ Recargas Free Fire" de la hoja). Sin ella, en modo API los pedidos de Free Fire van a "sin_codigo".
SCRIPT_BLOOD=https://script.google.com/macros/s/XXXXXXXX/exec
FAZER_API_KEY=

# Secreto del webhook de FazerCards (panel de FazerCards > Settings > Webhook, URL
# https://levelupstore.online/api/fazer-webhook). Usada en: api/fazer-webhook.js, que comprueba la firma
# X-Webhook-Signature y pasa el estado de cada orden a la pestaña "fazer_card" de la hoja de Free Fire.
FAZER_WEBHOOK_SECRET=

# --- Bot de canje (Railway) ---
# Usada en: api/_lib/juegos/freefire.js (recarga). Se envía en la cabecera x-secret-token al bot (POST /canjear).
# Debe ser EXACTAMENTE igual a la variable WEBHOOK_SECRET del servicio del bot en Railway;
# si no coincide, el bot responde 401 "No autorizado".
RAILWAY_SECRET=

# --- Límite de intentos fallidos de recarga (anti fuerza bruta de referencias) ---
# Usada en: api/_lib/limitador.js (desde las recargas de api/_lib/juegos/)
# JSON completo de una cuenta de servicio de Firebase, en UNA sola línea.
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# Sin esta variable el límite funciona solo en memoria (protección débil en Vercel).
FIREBASE_SERVICE_ACCOUNT=

# --- Gemini API (soporte IA) ---
# Usadas en: api/ia-soporte.js
# GEMINI_KEYS tiene prioridad: lista separada por comas para rotar claves.
# Si no está definida, se usa GEMINI_API_KEY como clave única.
GEMINI_KEYS=clave1,clave2
GEMINI_API_KEY=

# Modelo de Gemini para el chat (opcional). Por defecto: gemini-2.5-flash.
# Los modelos gemini-1.5-* fueron retirados por Google y responden 404.
GEMINI_MODEL=

# Opcional: oculta el aviso DEP0169 (url.parse) que aparece en los logs de Vercel. No viene de
# nuestro código (api/ no usa url.parse) sino del entorno de ejecución o de una librería; es inofensivo.
# NODE_OPTIONS=--disable-warning=DEP0169
