# Copia este archivo como .env y rellena los valores reales.
# En producción, estas variables se configuran en Vercel (Project Settings > Environment Variables).

# --- Google Apps Script (recargas generales) ---
# Usada en: api/precios.js, api/recargar.js, api/subir-imagen.js
SCRIPT_RECARGAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Usada en: api/consultar-ordenes.js
SCRIPT_RECARGAS_VERIFICACION=https://script.google.com/macros/s/XXXXXXXX/exec

# Usada en: api/verificar.js
SCRIPT_VALIDADOR_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Usada en: api/ruleta.js
SCRIPT_RULETA_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- Roblox ---
# Usada en: api/roblox.js
GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- Blood Strike ---
# Usadas en: api/precios-bloodstrike.js, api/recargar-bloodstrike.js
SCRIPT_BLOOD=https://script.google.com/macros/s/XXXXXXXX/exec
FAZER_API_KEY=

# --- Bot de canje (Railway) ---
# Usada en: api/recargar.js
RAILWAY_SECRET=

# --- Límite de intentos fallidos de recarga (anti fuerza bruta de referencias) ---
# Usada en: api/_lib/limitador.js (desde recargar.js, recargar-bloodstrike.js y roblox.js)
# JSON completo de una cuenta de servicio de Firebase, en UNA sola línea.
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# Sin esta variable el límite funciona solo en memoria (protección débil en Vercel).
FIREBASE_SERVICE_ACCOUNT=

# --- Gemini API (soporte IA) ---
# Usadas en: api/ia-soporte.js
# GEMINI_KEYS tiene prioridad: lista separada por comas para rotar claves.
# Si no está definida, se usa GEMINI_API_KEY como clave única.
GEMINI_KEYS=clave1,clave2
GEMINI_API_KEY=

# Modelo de Gemini para el chat (opcional). Por defecto: gemini-2.5-flash.
# Los modelos gemini-1.5-* fueron retirados por Google y responden 404.
GEMINI_MODEL=
