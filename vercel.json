{
  "functions": {
    "api/recargar.js": { "maxDuration": 180 },
    "api/juego.js": { "maxDuration": 30 },
    "api/creadores.js": { "maxDuration": 30 },
    "api/consultar-ordenes.js": { "maxDuration": 30 },
    "api/subir-imagen.js": { "maxDuration": 30 },
    "api/ruleta.js": { "maxDuration": 30 },
    "api/fazer-webhook.js": { "maxDuration": 30 },
    "api/centralone-webhook.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/precios", "destination": "/api/juego?juego=freefire&accion=precios" },
    { "source": "/api/precios-bloodstrike", "destination": "/api/juego?juego=bloodstrike&accion=precios" },
    { "source": "/api/verificar", "destination": "/api/juego?juego=freefire&accion=verificar" },
    { "source": "/api/recargar-bloodstrike", "destination": "/api/recargar?juego=bloodstrike" },
    { "source": "/api/roblox", "destination": "/api/recargar?juego=roblox" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|gif|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://levelupstore.online" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
