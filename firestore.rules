rules_version = '2';

// Reglas de seguridad de Firestore (proyecto levelupstore-87d4d).
// Este archivo NO se aplica solo: copiarlo en Firebase Console > Firestore Database > Reglas > Publicar.
//
// Antes de publicar: reemplazar PEGAR_AQUI_TU_UID por el UID de la cuenta de administrador
// (Firebase Console > Authentication > Usuarios > columna "UID de usuario").
//
// Quién usa Firestore y por qué estas reglas no lo rompen:
//  - Tiendas (public/js/datos-pago.js): solo LEEN configuracion/pago_movil, sin sesión.
//  - Panel (public/admin.html): con la sesión del administrador lee y edita Pagos, pedidos, cupones y
//    configuracion.
//  - Vercel (limites_recarga, con firebase-admin) y los Apps Script (con ScriptApp.getOAuthToken):
//    entran con credenciales de Google Cloud, que NO pasan por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null && request.auth.uid in ['PEGAR_AQUI_TU_UID'];
    }

    // Datos de Pago Móvil: los ve cualquiera (las tiendas los muestran), solo el admin los cambia.
    // Si alguien pudiera escribir aquí, cambiaría el número al que pagan los clientes.
    match /configuracion/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Todo lo demás (Pagos, pedidos, cupones, limites_recarga...): solo el administrador
    match /{documento=**} {
      allow read, write: if esAdmin();
    }
  }
}
